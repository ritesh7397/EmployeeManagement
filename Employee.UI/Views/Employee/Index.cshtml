@model EmployeeDetailViewModel

<div class="row">
    <div class="col-md-6">
        <table class="table">
            <tr>
                <th>Employee Name</th>
                <th>Salary</th>
                <th>Desciptions</th>
                <th>Action</th>
            </tr>

            @foreach(var employeedetail in Model.List)
            {
              <tr>
                  <td>@employeedetail.EmployeeName</td>
                  <td>@employeedetail.EmployeeSalary</td>
                  <td>@employeedetail.EmployeeDescription</td>
                  <td><a asp-controller="Employee" asp-action="GetById" asp-route-Id="@employeedetail.EmployeeId" class="btn btn-primary">Edit</a></td>
                  <td>
                      <a asp-controller="Employee" asp-action="Delete" asp-route-id ="@employeedetail.EmployeeId" class="btn btn-danger">Delete</a>
                  </td>
              </tr>
            }

        </table>

    </div>

    <div class="col-md-6">
        <h4>Employee deatil</h4>
        <form asp-asp-controller="Employee" asp-action="Create" method="post">
            <input type="hidden" asp-for="@Model.Employee.EmployeeId" name="EmployeeId"/>
            <div class="form-group">
                <label>Employee Name</label>
                <input asp-for="@Model.Employee.EmployeeName" name="EmployeeName" class="form-control"/>
            </div>
                <div class="form-group">
                <label>Salary</label>
                <input asp-for="@Model.Employee.EmployeeSalary" name="EmployeeSalary" class="form-control" />
            </div>
            <div class="form-group">
                <label>Desc</label>
                <input asp-for="@Model.Employee.EmployeeDescription" name="EmployeeDescription" class="form-control" />
            </div>

            <div>
                <input type="Submit" value="submit" class="btn btn-success"/>
            </div>
        </form>
    </div>

</div>